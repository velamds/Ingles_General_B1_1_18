verride": 1, "questions": [{"responses": [{"correct": 1, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"contents": [{"type": "pdf", "content": "engenn6le18ob02re7pdf01.pdf"}], "type": "question"}]}], "type": "DWS", "id": 11, "_data": [{"contents": [{"type": "text", "content": " \nExplain how to make a Christmas drink or dish.\n"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}], "type": "learning_skills"}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le18ob02re2img05.jpg", "audiosrc": "engenn6le18ob02re2aud01", "images": [{"time": "0", "image": "engenn6le18ob02re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le18ob02re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>: Peter! Merry Christmas!</br>\n<span class=\"strong\">Peter</span>: Do I smell mincemeat pie?</br>\n<span class=\"strong\">Vanessa</span>: Yes, you do. I always bake plenty of sweet treats.</br>\n<span class=\"strong\">Sally</span>: No diets this week!</br>\n<span class=\"strong\">Peter</span>: Here are a few gifts for under the tree."}, {"time": "13000", "image": "engenn6le18ob02re2img06.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Sit down. The food is almost ready.</br>\n<span class=\"strong\">Sally</span>: 1 p.m., right on schedule! How do you do that?</br>\n<span class=\"strong\">Vanessa</span>: Training!</br>\n<span class=\"strong\">Peter</span>: You laid bunches of holly on the table!"}, {"time": "21000", "image": "engenn6le18ob02re2img06.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: Dig in!</br>\n<span class=\"strong\">Sally</span>: Mmm. What do you add to your cranberry sauce?</br>\n<span class=\"strong\">Vanessa</span>: A cup of orange juice and a little ginger.</br>\n<span class=\"strong\">Sally</span>: Amazing!</br>\n<span class=\"strong\">Peter</span>: Does this turkey have chestnuts and raisins in it?</br>\n<span class=\"strong\">Vanessa</span>: Yes. It's roasted with a different type of stuffing."}, {"time": "36000", "image": "engenn6le18ob02re2img02.jpg", "id": 4, "text": "<span class=\"strong\">Peter</span>: There are lots of almonds with the vegetables too! </br>\n<span class=\"strong\">Vanessa</span>: I saute them a bit so they're crunchy!</br>\n<span class=\"strong\">Sally</span>: I've never had nuts with vegetables before! You mixed the yams and potatoes and grilled them right?</br>\n<span class=\"strong\">Vanessa</span>: Uhm hum.</br>\n<span class=\"strong\">Peter</span>: Every mouthful is perfect. Vanessa. Some day you are going to be a  famous chef!</br>\n<span class=\"strong\">Vanessa</span>: Thank you.</br>\n<span class=\"strong\">Sally</span>: Peter! You're having seconds already?</br>\n<span class=\"strong\">Peter</span>: I haven't eaten for days to be ready for this!</br>\n<span class=\"strong\">Vanessa</span>: Oh Peter!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Celebrating Christmas"}, {"type": "unit_name", "content": "Pigging Out"}, {"type": "position", "content": 2}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 18}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Identify and describe personal and regional eating habits and cooking in a range of communicative situations."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"contents": [{"type": "heading", "content": "The Simple Present Tense"}, {"type": "describer", "content": "You use the <span class=\"strong\">Simple Present</span> tense: <ul><li>to talk about things that are always true</li> <li>to give general information</li> <li>to talk about habits and routines</li> <li>with stative verbs like <span class=\"italic\">to be, to seem, to feel</span></li></ul>"}, {"type": "example", "content": "You're right on schedule! "}, {"type": "example", "content": "I always bake plenty of sweet treats."}, {"type": "example", "content": "I saut\u00e9 them a bit so they're crunchy!"}, {"type": "text", "content": "You use the Simple Present  and the Present Continuous tenses to talk about the present in different ways. "}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Quantities and Measures"}, {"type": "describer", "content": "When you cook, you use measures. "}, {"type": "text", "content": "You use a quantifier before a noun to indicate the amount or number of an item. Quantifiers do not indicate a specific quantity but rather a general amount."}, {"type": "table", "content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Quantifier\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a/an/one</br> some</br> plenty of</br> lots of</br> a few / a little</br> a bunch</br> a mouthful\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a single item</br> a general amount</br> more than is needed</br> a large amount</br> a small number or amount</br> a group</br> enough to fit in the mouth</br> comfortably\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "You laid bunches of holly on the table!"}, {"type": "example", "content": "Every mouthful is perfect."}, {"type": "example", "content": "There are lots of almonds with the vegetables too! "}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "to have seconds"}, {"type": "definition", "content": "to have a second plate of food"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: You're having seconds already! "}, {"type": "audio", "content": "engenn6le18ob02aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use to talk about Christmas dinner."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "crunchy"}, {"type": "definition", "content": "makes sounds when eating"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: These sauteed almonds are nice and crunchy. "}, {"type": "audio", "content": "engenn6le18ob02aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "stuffing"}, {"type": "definition", "content": "a filling baked inside a turkey or vegetable"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The stuffing has chestnuts in it. "}, {"type": "audio", "content": "engenn6le18ob02aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to roast"}, {"type": "definition", "content": "to cook in the oven"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: You have to roast the turkey for several hours! "}, {"type": "audio", "content": "engenn6le18ob02aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "mincemeat"}, {"type": "definition", "content": "a \u200bsweet, \u200bspicy \u200bmixture \u200bof apple, \u200bdried \u200bfruit, and \u200bnuts"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Do I smell mincemeat pie?"}, {"type": "audio", "content": "engenn6le18ob02aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "holly"}, {"type": "definition", "content": "a small evergreen tree with red berries"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You put bunches of holly on the table! "}, {"type": "audio", "content": "engenn6le18ob02aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "mouthful"}, {"type": "definition", "content": "what fits comfortably in your mouth"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Every mouthful of this dinner is perfect!"}, {"type": "audio", "content": "engenn6le18ob02aud07"}], "type": "target_word"}, {"type": "background_image", "content": "engenn6le18ob02re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Look up the instructions for something you like to eat at Christmas."}, {"type": "text", "content": "Write down the ingredients."}, {"type": "text", "content": "Write down instructions using  the Imperative."}, {"type": "text", "content": "Tell a partner how to put together the food. Use the Imperative."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I look up a Christmas for or drink."}, {"type": "text", "content": "I write down the ingredients and instructions."}, {"type": "text", "content": "I tell my partner how to make it. "}]}]}