_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Celebrating Christmas", "type": "lesson_name"}, {"content": "When I Was a Child ...", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 18, "type": "lesson"}, {"content": "B1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify and describe personal and regional eating habits and cooking in a range of communicative situations.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}]}, {"content": "engenn6le18ob10re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Used to and Would to Talk About Past Habits", "type": "heading"}, {"content": "<span class=\"strong\">Used to</span> and <span class=\"strong\">would</span> are both used to talk about past actions.", "type": "describer"}, {"content": "Did you used to visit Santa and have your picture taken with him when you were young?", "type": "example"}, {"content": "Does your family bring out the photo album and add to it each Christmas?", "type": "example"}, {"content": "You use <span class=\"italic\">used to</span>  to say that something happened in the past but doesn't happen any more. It uses -ed to show past tense.</p>   For example: I used to skate every winter. </br> (Before, I skated every winter, but now I don't skate.) </p>  When we were children, we used to skate all day long.</br>  (Before, we skated all day long, but now we don't skate all day long.) </p> We use would to talk about both past actions and past routines.</p>   <span class=\"italic\">Would</span> refers to actions, rather than situations.", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Structure\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I used to skate every winter.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I skated every winter before before, but now I don't. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">When we were children, we used to skate all day long. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Now we don't skate all day long.\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": "The Present Perfect vs.  The Simple Past Tense", "type": "heading"}, {"content": "You use the Present Perfect tense when the action has some relationship to now.</br> You use the Simple Past tense to talk about completed actions.", "type": "describer"}, {"content": "Let's look at some other ways to compare these tenses.", "type": "text"}, {"content": "{\"rows\":8,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Explanation\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The Present Perfect is used when the time period has NOT finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I have never skated. </p> (I still don't skate now)</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The Simple Past is used when the time HAS finished.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I didn't skate when I was young. </p>(I did not skate then)</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The Present Perfect is often used when giving recent news.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I have bought new skates! </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The Simple Past is used when giving older information.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I got some skates for my last birthday.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The Present Perfect is used when the time is not specific.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I've been to the Boston Common before.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The Simple Past is used when the time is clear.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I went to the Boston Common Last week.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "magic", "type": "name"}, {"content": "special powers that make things happen ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Christmas is a magic time for children. ", "type": "example"}, {"content": "engenn6le18ob10aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about Christmas as children.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to decorate", "type": "name"}, {"content": "to add something to a thing to make it attractive. ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: We would all decorate the tree together. ", "type": "example"}, {"content": "engenn6le18ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to hang up", "type": "name"}, {"content": "to put on a hook or nail", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: We hung up our Christmas stockings on the fireplace.", "type": "example"}, {"content": "engenn6le18ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "ornament", "type": "name"}, {"content": "a small decoration used on a Christmas tree", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We put each ornament in a special place. ", "type": "example"}, {"content": "engenn6le18ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Christmas stockings", "type": "name"}, {"content": "special socks used to put small Christmas treats in ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: In the morning our Christmas stockings were full of candies! ", "type": "example"}, {"content": "engenn6le18ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to pass out", "type": "name"}, {"content": "to give one by one", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Dad would pass out the ornaments. ", "type": "example"}, {"content": "engenn6le18ob10aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to stuff ", "type": "name"}, {"content": "to put inside until something is full", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: We would stuff ourselves with chocolates! ", "type": "example"}, {"content": "engenn6le18ob10aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "candy cane", "type": "name"}, {"content": "a red and white striped peppermint candy", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We put candy canes in our hot chocolate to melt. ", "type": "example"}, {"content": "engenn6le18ob10aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Santa ", "type": "name"}, {"content": "Santa Claus; the man who gives children toys at Christmas ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Santa left us lots of toys! ", "type": "example"}, {"content": "engenn6le18ob10aud09", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Make up an invitation to a holiday gathering.", "type": "text"}, {"content": "Say where and when you have decided to have the party.", "type": "text"}, {"content": "Say what traditional foods you have made.", "type": "text"}, {"content": "Read your invitation to a partner.", "type": "text"}, {"content": "Listen to your partner's invitation.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write an invitation.", "type": "text"}, {"content": "I say where I've decided to have the party.", "type": "text"}, {"content": "I talk about what food I've prepared.", "type": "text"}, {"content": "I read my invitation aloud. ", "type": "text"}, {"content": "I listen to my partner's invitation.", "type": "text"}]}], "type": "sena"}