: "group_name"}]}, {"content": {"correct_feedback": "You are done!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"content": [{"content": "The word <span class=\"italic\">\u201cskills\u201d</span> has the consonant blend, <span class=\"italic\">sk</span>.", "type": "text", "tip_id": 0}], "type": "tips"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Listen and record EACH word and phrase. Compare yourself to the audio.", "type": "text"}]}], "type": "SR1", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn6le18ob04re2img01.jpg"}, {"text": "Want to take a ski trip with your family?</p>There are a lot of things you have to consider when you are planning a family ski holiday. Firstly, you have to select a location that offers a range of slopes from beginner to advanced. You have got to be sure that the mountain caters to all levels.", "id": 1, "time": "100", "image": "engenn6le18ob04re2img01.jpg"}, {"text": "Secondly, you have to decide on how far you are prepared to travel, especially in poor weather. Make sure you choose a ski resort that offers a variety of activities both on and off the slopes. Activities can include a children's playground, a ski school, traffic-free areas for children to play, a nursery for small children and family-friendly restaurants. Some resorts even have outdoor skating rinks and Ski-Doo rentals.", "id": 2, "time": "21000", "image": "engenn6le18ob04re2img04.jpg"}, {"text": "Also, you're going to have to dress appropriately and have the right equipment for the weather. Ski masks, helmets, snowsuits, gloves and goggles are essential. Families can either purchase their own skis, boots and poles or rent them once they arrive.", "id": 3, "time": "54000", "image": "engenn6le18ob04re2img03.jpg"}], "audiosrc": "engenn6le18ob04re2aud01", "coverimg": "engenn6le18ob04re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}