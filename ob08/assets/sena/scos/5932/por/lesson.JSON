ext", "content": ""}]}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "type": "RSLT", "id": 10, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "template_override": 1, "questions": [{"responses": [{"correct": 1, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"contents": [{"type": "pdf", "content": "engenn6le18ob08re7pdf01.pdf"}], "type": "question"}]}], "type": "DWS", "id": 11, "_data": [{"contents": [{"type": "text", "content": " Tis the season to be jolly!"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le18ob08re2img01.jpg", "audiosrc": "engenn6le18ob08re2aud01", "images": [{"time": "0", "image": "engenn6le18ob08re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le18ob08re2img01.jpg", "id": 1, "text": "Dear Mika,\n</p>\nI want to wish you and your family joy and happiness.\n</p>\nIt's been over a year since we have seen each other. Thank you so much for the retro sweater and ear muffs! I am wearing the sweater right now! I saw that the gifts were from my favorite hipster store on the harbor. I'm glad that the gift certificate I sent you for the chef supply store will come in handy."}, {"time": "22000", "image": "engenn6le18ob08re2img01.jpg", "id": 2, "text": "I was just thinking about you the other day and how much fun we had together at culinary school. Last week, I made that Thai chili you gave me the recipe for. I am planning to include it in my upcoming cookbook, Vanessa Cooks, if that's okay with you I promise to include your name in the credits.</p>It would be nice if we could catch up over the holidays.  I have a couple days off after New Year's. Maybe we can organize to meet somewhere like Nashville or Chicago. What do you think?"}, {"time": "51000", "image": "engenn6le18ob08re2img01.jpg", "id": 3, "text": "Thanks again for the special gifts! I am so thankful that I have a friend like you in my life. </p>I hope you have a wonderful Christmas season and all the best in the coming year!</p>Love,</p>Vanessa"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "audio", "value": ""}], "template_override": 1, "title": "", "type": "text", "id": 2, "_data": []}, {"contents": [{"type": "video", "value": {"images": [{"time": "0", "image": "", "text": "", "id": 0}, {"time": "5000", "image": "", "text": "Christmas Cards", "id": 1}, {"time": "35000", "image": "", "text": "<span class=\"bullet\">They express your thoughts.</span>", "id": 2}, {"time": "77000", "image": "", "text": "<span class=\"bullet\">They are short and include a greeting or closing.</span>", "id": 3}], "video_src": "engenn6le18ob08re3vid01"}}], "template_override": 1, "title": "", "type": "video", "id": 3, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Celebrating Christmas"}, {"type": "unit_name", "content": "The Christmas Card"}, {"type": "position", "content": 8}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 18}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Writes short texts about presenting plans for a future activity at work using correct spelling, grammar, cohesion and coherence aspects appropriate to the communicative functions for this level."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le18ob08re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Writing a Christmas Card"}, {"type": "describer", "content": "You write Christmas cards to friends and loved-ones to show you are thinking about them during the holiday season."}, {"type": "example", "content": "Wishing your family peace, love, and joy at Christmas and always."}, {"type": "example", "content": "Wishing you a very merry Christmas."}, {"type": "example", "content": "Happy holidays, from our house to yours."}, {"type": "example", "content": "Sending wishes to you and yours for a beautiful holiday season and a peaceful New Year."}, {"type": "text", "content": "You can include:</p> Your thoughts</br> Example:<ul><li><span class=\"italic\">All my love and thoughts are on your during this Christmas season.</span></li> <li><span class=\"italic\">Sending you my thoughts and heartfelt wishes for a wonderful Christmas.</li></ul></span>  Why you are thankful </br>Example: <ul><li><span class=\"italic\">I am so lucky that you are part of my family.</span></li><li><span class=\"italic\">I am so thankful that I have a friend like you in my life.</span></li></ul>   A reflection</br> Example: <ul><li><span class=\"italic\">Thanks for being there for me this year. You are like a Christmas gift all year round.</span></li></ul> New Year or plans for the future</br> Example: <ul><li><span class=\"italic\">I love the holiday season because of the time I get to spend with you. Can't wait to see you soon.</span></li></ul>"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "The Future "}, {"type": "describer", "content": "You can use different tenses to talk about the future: The future simple, the present continuous, and be going to. "}, {"type": "text", "content": "When you make a decision at the time of speaking, you use will. <br> <span class=\"strong\">Example:</span> <span class=\"italic\">I hope we'll see each other soon!</span> <br><br>  For intentions (when something is already planned or definite), you use <span class = \"strong\">be going to</span>. <br> <span class=\"strong\">Example:</span> <span class=\"italic\">I'm going to wear my new sweater skating tonight.</span> <br><br>  For arrangements, you use the Present Continuous tense. <br> <span class=\"strong\">Example:</span> <span class=\"italic\">I am planning to include it in my upcoming cookbook, Vanessa Cooks.</span>"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "ear muffs"}, {"type": "definition", "content": "a piece of equipment worn on the ear to protect them from cold weather"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  Thank you so much for the retro sweater and ear muffs!"}, {"type": "audio", "content": "engenn6le18ob08aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you can in a letter to friends and family."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "upcoming"}, {"type": "definition", "content": "happening or appearing soon"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example:  We are looking forward to the upcoming event!"}, {"type": "audio", "content": "engenn6le18ob08aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "credits "}, {"type": "definition", "content": "a list of the names of the people who have worked on a book or movie"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I promise to include your name in the credits."}, {"type": "audio", "content": "engenn6le18ob08aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "hipster"}, {"type": "definition", "content": "a modern culture that values independent thinking, progressive politics, art and indie-rock, creativity, and  intelligence"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I saw that they were from my favorite hipster store on the harbor."}, {"type": "audio", "content": "engenn6le18ob08aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "retro"}, {"type": "definition", "content": "looking like or relating to styles or fashions from the past"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Thank you so much for the retro sweater."}, {"type": "audio", "content": "engenn6le18ob08aud05"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Design 3 Christmas cards for family members."}, {"type": "text", "content": "Write 30-45 words in each Christmas card."}, {"type": "text", "content": "Include a greeting, body paragraph and closing."}, {"type": "text", "content": "Choose different phrases."}, {"type": "text", "content": "Include <span class=\"italic\">will</span>, <span class=\"italic\">going to</span> and <span class=\"italic\">present continuous</span> for future"}, {"type": "text", "content": "Read your Christmas cards aloud to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I design 3 Christmas cards."}, {"type": "text", "content": "I write Christmas card to family members."}, {"type": "text", "content": "I read the cards aloud to a partner."}]}]}