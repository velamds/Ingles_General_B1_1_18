s": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn6le18ob08re2img01.jpg"}, {"text": "Dear Mika,\n</p>\nI want to wish you and your family joy and happiness.\n</p>\nIt's been over a year since we have seen each other. Thank you so much for the retro sweater and earmuffs! I am wearing the sweater right now! I saw that the gifts were from my favorite hipster store on the harbor. I'm glad that the gift certificate I sent you for the chef supply store will come in handy.", "id": 1, "time": "100", "image": "engenn6le18ob08re2img01.jpg"}, {"text": "I was just thinking about you the other day and how much fun we had together at culinary school. Last week, I made that Thai chili you gave me the recipe for. I am planning to include it in my upcoming cookbook, <span class=\"italic\">Vanessa Cooks</span>, if that's okay with you. I promise to include your name in the credits.</p>It would be nice if we could catch up over the holidays.  I have a couple days off after New Year's. Maybe we can organize to meet somewhere like Nashville or Chicago. What do you think?", "id": 2, "time": "22000", "image": "engenn6le18ob08re2img01.jpg"}, {"text": "Thanks again for the special gifts! I am so thankful that I have a friend like you in my life. </p>I hope you have a wonderful Christmas season and all the best in the coming year!</p>Love,</p>Vanessa", "id": 3, "time": "51000", "image": "engenn6le18ob08re2img01.jpg"}], "audiosrc": "engenn6le18ob08re2aud01", "coverimg": "engenn6le18ob08re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 2, "title": "", "contents": [{"value": "", "type": "audio"}], "_data": [], "type": "text", "template_override": 1}, {"id": 3, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": ""}, {"text": "Christmas Cards", "id": 1, "time": "5000", "image": ""}, {"text": "<span class=\"bullet\">They express your thoughts.</span>", "id": 2, "time": "35000", "image": ""}, {"text": "<span class=\"bullet\">They are short and include a greeting or closing.</span>", "id": 3, "time": "77000", "image": ""}], "video_src": "engenn6le18ob08re3vid01"}, "type": "video"}], "_data": [], "type": "video", "template_override": 1}]}]}