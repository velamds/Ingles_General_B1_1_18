[], "template_override": 1, "questions": [{"responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}], "id": 0, "_data": [{"contents": [{"type": "pdf", "content": "engenn6le18ob06re7pdf01.pdf"}], "type": "question"}]}], "type": "DWS", "id": 11, "_data": [{"contents": [{"type": "text", "content": " \nTalk about your ideas on gift giving.\n"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}], "type": "learning_skills"}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le18ob06re2img01.jpg", "audiosrc": "engenn6le18ob06re2aud01", "images": [{"time": "0", "image": "engenn6le18ob06re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le18ob06re2img01.jpg", "id": 1, "text": "We give gifts hoping to please the recipient. Gifts have never been a substitute for love or caring. However a carefully chosen gift can show both.</p>Choosing the perfect gift for a celebration has always been difficult. A box of chocolates, a pair of earrings or some  perfume for a woman have generally been customary. A set of cufflinks or a bottle of aftershave for a man were traditional standards for many years."}, {"time": "27000", "image": "engenn6le18ob06re2img02.jpg", "id": 2, "text": "One year I got a dozen pairs of funky socks for Christmas. They made my day. My grandparents were ecstatic over the new bundle of joy called Teddy my mother brought home one Christmas Day. Other gifts paled in comparison."}, {"time": "42000", "image": "engenn6le18ob06re2img03.jpg", "id": 3, "text": "Gift traditions have changed throughout the years. I haven't chosen jewelry or a tie for anyone lately. I've given more thoughtful, personal items. These were things I paid little for. Often they were highly cherished.  A lot of us have less money to spend these days. Breaking with established customs seems to be the modern way to go."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}]}