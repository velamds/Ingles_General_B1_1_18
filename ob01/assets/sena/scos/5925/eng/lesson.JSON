{"_data": [{"type": "metadata", "contents": [{"content": "Celebrating Christmas", "type": "lesson_name"}, {"content": "Christmas Traditions", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 18, "type": "lesson"}, {"content": "B1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify and describe personal and regional eating habits and cooking in a range of communicative situations.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Quantities and Measures", "type": "heading"}, {"content": "When you cook, you use measures. ", "type": "describer"}, {"content": "There's one for each of us. ", "type": "example"}, {"content": "I put in a lot of ginger.", "type": "example"}, {"content": "Beat half a dozen eggs in this bowl.", "type": "example"}, {"content": "You use measures to talk about a specific amount when cooking. The measures can be international, in grams, kilos, and liters or American/Imperial measures, in teaspoons, cups and quarts.</p> You use a quantifier before a noun to indicate the amount or number of an item. Quantifiers do not indicate a specific quantity but rather a general amount.", "type": "text"}, {"content": "{\"rows\":8,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Measurements\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Amount\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a cup\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\".23 liters\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a pinch/a dash\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a very small amount\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a teaspoon\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"5 ml; a small measuring spoon\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a tablespoon\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"15 ml; a large measuring spoon\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"half a dozen\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"6\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Quantifier\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a/an/one</br> some</br> plenty of</br> a lot of\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a single item</br> a general amount</br> more than is needed</br> a large amount\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": "The Imperative", "type": "heading"}, {"content": "You use the Imperative to give instructions.", "type": "describer"}, {"content": "Beat half a dozen eggs in this bowl. ", "type": "example"}, {"content": "Add 3 cups milk and 8 tablespoons sugar. ", "type": "example"}, {"content": "Then put it on the burner and heat it very slowly.", "type": "example"}, {"content": "The Imperative only has one form.</br>  The Imperative does not use a subject. </br> The subject, <span class=\"italic\">You</span>, is understood.</br> You often use the Imperative when you cook.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "savory", "type": "name"}, {"content": "salty or spicy; not sweet", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I've cooked some savory dishes. ", "type": "example"}, {"content": "engenn6le18ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you talk about cooking at Christmas.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to cook up a storm", "type": "name"}, {"content": "to cook with great energy and skill", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: She's really cooked up a storm for the event!", "type": "example"}, {"content": "engenn6le18ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "mixer", "type": "name"}, {"content": "a small appliance used to beat or whip food ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Use the mixer to beat the eggs.", "type": "example"}, {"content": "engenn6le18ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bite", "type": "name"}, {"content": "a sharp or strong taste ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The gingerbread has a bite to it! ", "type": "example"}, {"content": "engenn6le18ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "gingerbread", "type": "name"}, {"content": "a cookie that contains ginger", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You made gingerbread houses! ", "type": "example"}, {"content": "engenn6le18ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "eggnog", "type": "name"}, {"content": "a traditional Christmas drink made with eggs, cream and spices ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You can whip up the traditional eggnog! ", "type": "example"}, {"content": "engenn6le18ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tofu", "type": "name"}, {"content": "a high protein food made from soybeans ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: It's a tofu turkey? ", "type": "example"}, {"content": "engenn6le18ob01aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "nutmeg", "type": "name"}, {"content": "a brown spice from a nut ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Sprinkle some nutmeg on the eggnog. ", "type": "example"}, {"content": "engenn6le18ob01aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "cinnamon", "type": "name"}, {"content": "a spice made from the bark of a tree ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I like cinnamon in my eggnog too!", "type": "example"}, {"content": "engenn6le18ob01aud09", "type": "audio"}]}, {"content": "engenn6le18ob01re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Look up Christmas Recipes or Holiday Foods online.", "type": "text"}, {"content": "Find 1 savory item and 1 sweet item that look appealing to you.", "type": "text"}, {"content": "Print out the pictures or do a little diagram of them.", "type": "text"}, {"content": "Explain what the food is and what goes into it.", "type": "text"}, {"content": "Read your description to a partner.", "type": "text"}, {"content": "Do they think the food is appealing as well?", "type": "text"}, {"content": "Ask them why or why not.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I look up holiday foods.", "type": "text"}, {"content": "I write about 1 savory and 1 sweet item.", "type": "text"}, {"content": "I read my description aloud.", "type": "text"}, {"content": "I ask my partner how appealing the food is to them. ", "type": "text"}]}], "labs": [{"stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn6le18ob01re2aud01", "images": [{"image": "engenn6le18ob01re2img01.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn6le18ob01re2img01.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Come on in! </br>\n<span class=\"strong\">Sally</span>: Oh Vanessa, it smells Christmassy in here! It's savory and sweet and spicy too!</br>\n<span class=\"strong\">Vanessa</span>: Well, I have cooked up a storm in here! </br>\n<span class=\"strong\">Sally</span>: You made tiny gingerbread houses! </br>\n<span class=\"strong\">Vanessa</span>: It's a family custom! There's one for each of us. I put in a lot of ginger. It has a nice bite to it. </br>\n<span class=\"strong\">Sally</span>: What can I do?</br>\n<span class=\"strong\">Vanessa</span>: You can make some traditional eggnog.  </br>\n<span class=\"strong\">Sally</span>: Okay.", "time": "100"}, {"image": "engenn6le18ob01re2img07.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Here's the mixer.  Beat half a dozen eggs in this bowl. Add 3 cups milk and 8 tablespoons sugar.  It will get a bit thick. Then put it in a pot and heat it very slowly.</br>\n<span class=\"strong\">Sally</span>: I can do that. What else is on the menu?</br>\n<span class=\"strong\">Vanessa</span>: There's ham, tofu turkey, plenty of vegetables, and cranberry sauce to start. </br>\n<span class=\"strong\">Sally</span>: Tofu turkey?</br>\n<span class=\"strong\">Vanessa</span>: Let's see if Peter knows the difference.", "time": "26000"}, {"image": "engenn6le18ob01re2img09.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: This is ready. What now?</br>\n<span class=\"strong\">Vanessa</span>: Add 2 teaspoons of vanilla. Sprinkle it with \u00bd teaspoon of nutmeg and a pinch or two of cinnamon. Cover it and put it in the fridge.</br>\n<span class=\"strong\">Sally</span>: Wow! I'm cooking!", "time": "52000"}], "coverimg": "engenn6le18ob01re2img01.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "img_path": "", "type": "WLC", "_data": [{"type": "instructions", "contents": [{"content": "I can talk about celebrations, customs, and traditions.", "type": "Learning Outcomes"}, {"content": "I can describe how to prepare food.", "type": "Learning Outcomes"}, {"content": "I can talk about quantities and amounts.", "type": "Learning Outcomes"}, {"content": "What type of meal does your family have on a traditional holiday like Christmas?", "type": "Free Header Item"}, {"content": " What is your favourite part of the meal?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct", "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "What are you cooking?", "type": "free_type_text_area"}], "questions": []}, {"id": 1, "template_override": 1, "stimuli_ids": [1], "_data": [{"type": "instructions", "contents": [{"content": "Vanessa made tiny <span class=\"tool-tip\" id=\"tip_1_0\">gingerbread houses</span>! ", "type": "text"}]}, {"type": "group", "contents": [{"content": "Content", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}]}, {"content": [{"content": "A <span class=\"italic\">\u201cgingerbread house\u201d</span> is made with stiff gingerbread, put together with hard icing and decorated with candies.", "type": "text", "tip_id": 0}], "type": "tips"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Click on the play button to listen to the audio.", "type": "text"}]}], "type": "STI", "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0, "response